<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_startup"
            android:textStyle="bold"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/startupGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/startupNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_startup_new" />

            <RadioButton
                android:id="@+id/startupFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_startup_file" />

            <RadioButton
                android:id="@+id/startupDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_startup_dir" />
        </RadioGroup>

        <!-- Only meaningful together with "上次打开的文件", so it follows that choice. -->
        <CheckBox
            android:id="@+id/rememberLineCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/settings_remember_line"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_autosave"
            android:textStyle="bold"
            android:textSize="15sp" />

        <!-- Free-form seconds: any value, not a fixed list. 0 = off. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/autosaveInput"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:importantForAutofill="no"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/settings_autosave_unit"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_autosave_note"
                android:textSize="12sp"
                android:textColor="#888888" />
        </LinearLayout>

        <TextView
            android:id="@+id/fontLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/fontSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/lineNumbersCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_line_numbers"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/wordWrapCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_word_wrap"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_encoding"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/encodingSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
